# Spotify Now Playing widget on /dashboard (see scripts/get_spotify_refresh_token.js)
# Register an app at https://developer.spotify.com/dashboard, add
# http://127.0.0.1:8888/callback as a Redirect URI, then run:
#   SPOTIFY_CLIENT_ID=... SPOTIFY_CLIENT_SECRET=... node scripts/get_spotify_refresh_token.js
# Set all three in Netlify env vars (Functions scope).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Strava Last Activity widget on /dashboard (see scripts/get_strava_refresh_token.js)
# Create an app at https://www.strava.com/settings/api with Authorization
# Callback Domain set to 127.0.0.1, then run:
#   STRAVA_CLIENT_ID=... STRAVA_CLIENT_SECRET=... node scripts/get_strava_refresh_token.js
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# GitHub widget on /dashboard
# Create a classic Personal Access Token at https://github.com/settings/tokens.
# No scopes are required — the dashboard only reads the public contribution calendar
# and public events feed. The token just lifts the unauthenticated rate limit.
GITHUB_TOKEN=

# Cloudinary metadata fetch for /gallery (location captions, etc.)
# Settings → API Keys in your Cloudinary dashboard. Function-only, never exposed.
# Without these the gallery falls back to the public list endpoint with no captions.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# /bach party game (password-gated; not linked from nav)
BACH_PASSWORD=
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o. gpt-5.x / o-series also work (see netlify/functions/bach/story.js).
OPENAI_MODEL=
# Optional. Story illustration quality: low | medium | high (default: medium). Higher = slower + costlier.
BACH_IMAGE_QUALITY=

# Oura recovery data on /running (see scripts/get_oura_refresh_token.js).
# OURA_REFRESH_TOKEN only seeds the first refresh — Oura's refresh tokens are
# single-use, so the live pair is rotated into Blobs (see _shared/oura.js).
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REFRESH_TOKEN=

# Password-gated galleries: one GALLERY_<SCOPE>_PASSWORD per gated scope
# (/gallery/ride → GALLERY_RIDE_PASSWORD). An unset scope behaves as a wrong
# password, never as public.
GALLERY_RIDE_PASSWORD=
GALLERY_RUN_PASSWORD=
GALLERY_WEDDING_PASSWORD=

# /bach party packs from a private repo, read at runtime. Use a fine-grained
# token scoped to that one repository with read-only Contents access — it is
# the only credential here that can read private code.
PRIVATE_ACCESS_GITHUB_TOKEN=
# Optional. Defaults: maxeisen/private, main, matthew-jane.
BACH_PRIVATE_REPO=
BACH_PRIVATE_BRANCH=
BACH_PARTY_SEED_ALLOWLIST=

# Training plan for /running, read from Runna's calendar feed (Runna → Profile
# → Connected Apps & Watches → Calendar Sync → copy the iCal link). Functions
# scope only. The link is a bearer secret: anyone holding it can read the plan
# and the start location of every completed run, so it never goes in the repo.
# Unset → the plan comes from public/content/running/current-plan.json alone.
RUNNA_ICS_URL=
